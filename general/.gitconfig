[user]
   name = Bear BlinSchauer
    email = bearweston07@gmail.com
	signingkey = /home/bear/.ssh/id_ed25519.pub
[gpg "ssh"]
	allowedSignersFile = /home/bear/.ssh/allowed_signers
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[url "git@github.com:"]
	insteadOf = https://github.com/
[url "git@github.umn.edu:"]
	insteadOf = https://github.umn.edu/
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
