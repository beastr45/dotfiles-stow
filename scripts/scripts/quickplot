#!/usr/bin/env python3
import pandas as pd
import matplotlib.pyplot as plt
import sys

def main():
    # Prompt for CSV file
    filename = sys.argv[1]

    try:
        data = pd.read_csv(filename)
    except FileNotFoundError:
        print(f"Error: File '{filename}' not found.")
        return
    except Exception as e:
        print(f"Failed to read CSV: {e}")
        return

    # Show available columns
    print("\nAvailable columns:")
    for i, col in enumerate(data.columns):
        print(f"{i}: {col}")

    # Ask for X and Y columns
    x_col = input("\nEnter X column name or index: ").strip()
    y_col = input("Enter Y column name or index: ").strip()

    # Convert numeric input to actual column names
    if x_col.isdigit():
        x_col = data.columns[int(x_col)]
    if y_col.isdigit():
        y_col = data.columns[int(y_col)]

    # Validate columns
    if x_col not in data.columns or y_col not in data.columns:
        print("Invalid column selection.")
        return

    # Plot

    # Ask if user wants logarithmic axes
    logx = input("Logarithmic X-axis? (y/n): ").strip().lower() == "y"
    logy = input("Logarithmic Y-axis? (y/n): ").strip().lower() == "y"

    # Apply log scales if chosen
    if logx:
        plt.xscale('log')
    if logy:
        plt.yscale('log')

    plt.figure(figsize=(8, 5))
    plt.plot(data[x_col], data[y_col], marker='o')
    plt.xlabel(x_col)
    plt.ylabel(y_col)
    plt.title(f"{y_col} vs {x_col}")
    plt.grid(True)
    plt.tight_layout()
    plt.show()

if __name__ == "__main__":
    main()
